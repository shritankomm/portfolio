---
import '../styles/global.css';
import { url } from '../lib/url';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = url('og.png') } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_CONFIG.name,
  jobTitle: 'Robotics builder',
  url: Astro.site?.toString(),
  sameAs: [SITE_CONFIG.links.github, SITE_CONFIG.links.youtube, SITE_CONFIG.links.linkedin]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
